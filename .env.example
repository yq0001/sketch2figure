# Application
APP_NAME=Sketch2Figure
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite:///./data/sketch2figure.db
DATA_DIR=./data
MAX_UPLOAD_MB=25

# Provider credentials (backend only; never expose to frontend)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# How to configure provider keys:
# - Create a file named `.env` in the repository root (not committed to Git).
# - Populate the three keys below (example values removed):
#   OPENAI_API_KEY=sk-... (OpenAI)
#   GEMINI_API_KEY=ya29... (Google/Vertex)
#   ANTHROPIC_API_KEY=sk-... (Anthropic/Claude)
# - Restart the backend server so `pydantic-settings` reads the new values.
# - Alternatively, set environment variables in your shell or CI secrets.
#
# In CI, add repository secrets: `OPENAI_API_KEY`, `GEMINI_API_KEY`, `ANTHROPIC_API_KEY`.
# Use `get_settings().openai_api_key` etc. in code; the app already reads these values from env.

# Keep model IDs configurable. Set these to currently supported image models
# when provider integration is implemented in later phases.
OPENAI_IMAGE_MODEL=
GEMINI_IMAGE_MODEL=
CLAUDE_IMAGE_MODEL=

# External paid integration tests are OFF unless explicitly enabled.
RUN_EXTERNAL_AI_TESTS=0
