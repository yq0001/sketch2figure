# Application
APP_NAME=Sketch2Figure
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite:///./data/sketch2figure.db
DATA_DIR=./data
MAX_UPLOAD_MB=25

# Provider credentials (backend only; never expose to frontend)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Keep model IDs configurable. Set these to currently supported image models
# when provider integration is implemented in later phases.
OPENAI_IMAGE_MODEL=
GEMINI_IMAGE_MODEL=
CLAUDE_IMAGE_MODEL=

# External paid integration tests are OFF unless explicitly enabled.
RUN_EXTERNAL_AI_TESTS=0
